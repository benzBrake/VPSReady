services:
    php:
        image: php:7.4-fpm-custom
        container_name: "php"
        restart: always
        build:
           context: ${EZ_DATA}/Dockerfiles
           dockerfile: php
        ports:
            - "127.0.0.1:9000:9000"
        environment:
            - TZ=Asia/Shanghai
        volumes:
            - ${EZ_DATA}/web/webapps:/data/web/webapps
        networks:
            - net-app
    mysql:
        image: mysql
        container_name: mysql
        command: --default-authentication-plugin=mysql_native_password
        restart: always
        user: 1001:1001
        environment:
            MYSQL_ROOT_PASSWORD: root
        volumes:
            - ${EZ_DATA}/mysql:/var/lib/mysql
        ports:
            - "127.0.0.1:3306:3306"
        networks:
            - net-app
    bitwarden:
        image: bitwardenrs/server:latest
        container_name: bitwarden
        restart: always
        env_file:
            - ${EZ_DATA}/bitwarden/config.env
        volumes:
            - ${EZ_DATA}/bitwarden:/data/bitwarden
        networks:
            - net-app
networks:
    net-app:
